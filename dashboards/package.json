{
  "name": "@perses-dev/dashboards",
  "version": "0.56.0-beta.0",
  "description": "The dashboards feature in Perses",
  "license": "Apache-2.0",
  "homepage": "https://github.com/perses/perses/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/shared.git"
  },
  "bugs": {
    "url": "https://github.com/perses/perses/issues"
  },
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist/",
    "build": "concurrently \"npm:build:*\"",
    "build:esm": "swc ./src -d dist --strip-leading-paths --config-file ../.swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "start": "concurrently -P \"npm:build:* -- {*}\" -- --watch",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@perses-dev/client": "0.56.0-beta.0",
    "@perses-dev/components": "0.56.0-beta.0",
    "@perses-dev/plugin-system": "0.56.0-beta.0",
    "@perses-dev/spec": "0.3.0",
    "@snapgridjs/react": "^0.12.0",
    "@tanstack/hotkeys": "^0.18.0",
    "@tanstack/react-hotkeys": "^0.17.0",
    "dompurify": "^3.4.17",
    "immer": "^11.2.9",
    "marked": "^18.1.2",
    "mdi-material-ui": "^8.0.0",
    "react-compiler-runtime": "^1.0.0",
    "react-hook-form": "^7.91.0",
    "react-intersection-observer": "^11.0.1",
    "use-immer": "^0.11.0",
    "use-query-params": "^2.2.1",
    "use-resize-observer": "^10.0.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "history": "^5.3.0"
  },
  "peerDependencies": {
    "@mui/material": "^6.1.10",
    "@tanstack/react-query": "^5.105.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "files": [
    "dist"
  ]
}
