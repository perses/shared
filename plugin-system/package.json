{
  "name": "@perses-dev/plugin-system",
  "version": "0.55.0-beta.7",
  "description": "The plugin feature in Pereses",
  "license": "Apache-2.0",
  "homepage": "https://github.com/perses/perses/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/shared.git"
  },
  "bugs": {
    "url": "https://github.com/perses/perses/issues"
  },
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist/",
    "build": "concurrently \"pnpm build:esm\" \"pnpm build:types\"",
    "build:esm": "swc ./src -d dist --strip-leading-paths --config-file ../.swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "start": "concurrently -P \"pnpm build:esm -- {*}\" \"pnpm build:types -- {*}\" -- --watch",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@module-federation/enhanced": "^2.8.0",
    "@perses-dev/client": "workspace:0.55.0-beta.7",
    "@perses-dev/components": "workspace:0.55.0-beta.7",
    "@perses-dev/spec": "0.3.0-beta.5",
    "date-fns": "^4.2.1",
    "date-fns-tz": "^3.2.0",
    "immer": "^10.2.0",
    "react-hook-form": "^7.76.0",
    "semver": "^7.8.0",
    "use-query-params": "^2.2.1",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.10.0",
    "@mui/material": "^6.1.10",
    "@tanstack/react-query": "^4.44.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/semver": "^7.7.1"
  }
}
