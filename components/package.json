{
  "name": "@perses-dev/components",
  "version": "0.55.0-beta.7",
  "description": "Common UI components used across Perses features",
  "license": "Apache-2.0",
  "homepage": "https://github.com/perses/perses/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/shared.git"
  },
  "bugs": {
    "url": "https://github.com/perses/perses/issues"
  },
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist/",
    "build": "concurrently \"pnpm build:esm\" \"pnpm build:types\"",
    "build:esm": "swc ./src -d dist --strip-leading-paths --config-file ../.swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "start": "concurrently -P \"pnpm build:esm -- {*}\" \"pnpm build:types -- {*}\" -- --watch",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.4.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.0.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lint": "^6.9.2",
    "@date-fns/tz": "^1.4.1",
    "@fontsource/inter": "^5.0.0",
    "@mui/x-date-pickers": "^7.23.1",
    "@perses-dev/spec": "0.3.0-beta.5",
    "@perses-dev/client": "workspace:0.55.0-beta.7",
    "numbro": "^2.3.6",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/table-core": "^8.20.5",
    "@uiw/react-codemirror": "^4.25.3",
    "date-fns": "^4.2.1",
    "echarts": "5.5.0",
    "immer": "^10.2.0",
    "lodash": "^4.18.1",
    "mathjs": "^15.1.1",
    "mdi-material-ui": "^7.9.4",
    "notistack": "^3.0.2",
    "react-colorful": "^5.6.1",
    "react-error-boundary": "^3.1.4",
    "react-virtuoso": "^4.12.2"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^6.1.10",
    "lodash": "^4.18.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "files": [
    "dist"
  ]
}
