{
  "name": "perses-shared",
  "description": "Monorepo for the Perses UI shared packages",
  "version": "0.55.0-beta.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "turbo run format:root",
    "format:check": "turbo run format:root:check",
    "format:root": "oxfmt",
    "format:root:check": "oxfmt --check",
    "type-check": "turbo run type-check",
    "start": "turbo run start",
    "clean": "turbo run clean",
    "reinstall": "npm run clean && rm -rf **/node_modules && npm install",
    "clear-turbo-cache": "rimraf ./.turbo/cache",
    "doctor": "npx react-doctor@latest"
  },
  "workspaces": [
    "components",
    "dashboards",
    "plugin-system",
    "explore",
    "client"
  ],
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-refresh": "^0.18.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.11",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@10.9.2"
}
