{
  "name": "@perses-dev/explore",
  "version": "0.55.0-beta.7",
  "description": "The explore feature in Perses",
  "license": "Apache-2.0",
  "homepage": "https://github.com/perses/perses/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/shared.git"
  },
  "bugs": {
    "url": "https://github.com/perses/perses/issues"
  },
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist/",
    "build": "concurrently \"pnpm build:esm\" \"pnpm build:types\"",
    "build:esm": "swc ./src -d dist --strip-leading-paths --config-file ../.swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "start": "concurrently -P \"pnpm build:esm -- {*}\" \"pnpm build:types -- {*}\" -- --watch",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@nexucis/fuzzy": "^0.5.1",
    "@perses-dev/components": "workspace:0.55.0-beta.7",
    "@perses-dev/dashboards": "workspace:0.55.0-beta.7",
    "@perses-dev/plugin-system": "workspace:0.55.0-beta.7",
    "mdi-material-ui": "^7.9.4",
    "qs": "^6.14.0",
    "react-virtuoso": "^4.12.2",
    "use-query-params": "^2.2.1",
    "use-resize-observer": "^9.0.0"
  },
  "devDependencies": {
    "@types/qs": "^6.14.0",
    "react-router-dom": "^6.30.4"
  },
  "peerDependencies": {
    "@mui/material": "^6.1.10",
    "@tanstack/react-query": "^4.44.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "files": [
    "dist"
  ]
}
